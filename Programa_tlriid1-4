function labOrdenHistoria() {
  const box = $('#t1-lab-orden-h'); if (!box) return; const EV = [['A', 'Marta recibe una carta'], ['B', 'Recuerda su infancia en el pueblo'], ['C', 'Viaja al pueblo'], ['D', 'Imagina cómo será su vejez']];
  /* orden del discurso: A, B (analepsis), C, D (prolepsis); orden cronológico de la historia: B, A, C, D */
  const disc = ['A', 'B', 'C', 'D'], chron = ['B', 'A', 'C', 'D']; const tl = $('.tline', box); let mode = 'disc';
  tl.innerHTML = '<div class="axis"></div><span class="axl" style="left:0">antes</span><span class="axl" style="right:0">después</span>' + EV.map(([k, t]) => `<div class="ev ${k === 'B' ? 'fb' : k === 'D' ? 'ff' : ''}" data-k="${k}" style="--w:25%"><b>${k === 'B' ? 'analepsis' : k === 'D' ? 'prolepsis' : 'presente del relato'}</b>${t}</div>`).join('');
  const place = () => { const ord = mode === 'disc' ? disc : chron; $$('.ev', tl).forEach(e => { const i = ord.indexOf(e.dataset.k); e.style.left = `calc(${i * 25}% + 4px)`; e.style.top = (mode === 'chron' && e.dataset.k === 'D' ? 30 : 30) + 'px'; });
    $('.out', box).innerHTML = mode === 'disc' ? '<b>Orden del discurso</b> (como se cuenta): el relato empieza con la carta, <b>retrocede</b> a la infancia (analepsis), sigue con el viaje y <b>se adelanta</b> a la vejez (prolepsis). Es un orden <b>no lineal</b>.' : '<b>Orden cronológico</b> de la historia (como ocurrió): primero la infancia, luego la carta y el viaje; la vejez imaginada queda al final. Presiona otra vez para volver.'; };
  $('.b-play', box).onclick = () => { mode = mode === 'disc' ? 'chron' : 'disc'; $('.b-play', box).textContent = mode === 'disc' ? '⇄ Ver en orden cronológico' : '⇄ Ver como se narra'; place(); }; place();
}
