<!doctype html>
<html lang="es" data-bs-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Cuadernillo del TLRIID I a IV</title>
<meta name="description" content="Cuadernillo interactivo de repaso del Taller de Lectura, Redacción e Iniciación a la Investigación Documental I a IV (CCH-UNAM, programa 2024): aprendizajes, contenido con fuentes, actividades interactivas y animadas, ejercicios aleatorios, guías rápidas, cartas descriptivas y manual de uso.">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Source+Sans+3:wght@400;600;700;800&display=swap">
<style>
:root{
  --ink:#1d2433; --muted:#5b6475; --paper:#fbfaf6; --card:#ffffff; --line:#e6e2d6; --grid:rgba(30,60,120,.055);
  --u1:#0f766e; --u2:#b45309; --u3:#7c3aed; --acc:var(--u1); --ok:#15803d; --bad:#b91c1c;
  --shade:rgba(15,118,110,.22); --shade2:rgba(180,83,9,.25);
  --font-head:'Fraunces',Georgia,serif; --font-body:'Source Sans 3',system-ui,-apple-system,'Segoe UI',sans-serif;
}
[data-bs-theme=dark]{
  --ink:#e8e6df; --muted:#a3a9b6; --paper:#14171d; --card:#1c2029; --line:#2d3340; --grid:rgba(160,190,255,.05);
  --u1:#2dd4bf; --u2:#fbbf24; --u3:#a78bfa; --shade:rgba(45,212,191,.25); --shade2:rgba(251,191,36,.25);
}
html{scroll-behavior:smooth;scroll-padding-top:72px}
body{background:var(--paper);color:var(--ink);font-family:var(--font-body);font-size:1.04rem;line-height:1.62;
  background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:24px 24px}
h1,h2,h3,h4,.font-head{font-family:var(--font-head);letter-spacing:-.01em}
a{color:var(--acc)}
.navbar{background:color-mix(in srgb,var(--card) 88%,transparent)!important;backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.navbar .nav-link{color:var(--muted);font-weight:600;font-size:.95rem}
.navbar .nav-link.active,.navbar .nav-link:hover{color:var(--acc)}
#progress{position:fixed;top:0;left:0;height:3px;background:linear-gradient(90deg,var(--u1),var(--u2),var(--u3));z-index:2000;width:0;transition:width .1s}
.hero{padding:7rem 0 3rem;position:relative;overflow:hidden}
.hero h1{font-size:clamp(2rem,5vw,3.4rem);font-weight:700;line-height:1.1}
.hero .lead{color:var(--muted);max-width:44rem}
.hero-svg{width:100%;max-width:520px;height:auto}
.hero-svg .draw{stroke-dasharray:1400;stroke-dashoffset:1400;animation:draw 2.4s ease forwards .3s}
@keyframes draw{to{stroke-dashoffset:0}}
.hero-svg .bar{transform-origin:bottom;transform-box:fill-box;animation:grow .9s cubic-bezier(.2,.8,.2,1) both}
@keyframes grow{from{transform:scaleY(0)}to{transform:scaleY(1)}}
.chip{display:inline-block;padding:.12rem .6rem;border-radius:99px;font-size:.78rem;font-weight:700;border:1px solid var(--line);background:var(--card);color:var(--muted)}
.unit-tag{display:inline-block;font-weight:800;font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;color:var(--uc);border:2px solid var(--uc);border-radius:6px;padding:.05rem .45rem}
.u1{--uc:var(--u1)} .u2{--uc:var(--u2)} .u3{--uc:var(--u3)}
section.unit{padding:3.5rem 0 1rem}
.unit-head{border-left:6px solid var(--uc);padding-left:1rem;margin-bottom:1.5rem}
.unit-head h2{font-weight:700;margin:.3rem 0}
.topic{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:1.5rem;margin-bottom:1.75rem;box-shadow:0 1px 0 rgba(0,0,0,.02),0 8px 24px -16px rgba(0,0,0,.25)}
.topic>h3{font-size:1.45rem;font-weight:650;display:flex;gap:.6rem;align-items:baseline}
.topic>h3 .num{color:var(--uc);font-size:1rem;font-family:var(--font-body);font-weight:800}
.topic h4{font-size:1.1rem;font-weight:650;margin-top:1.2rem;color:var(--uc)}
.def{border-left:4px solid var(--uc);background:color-mix(in srgb,var(--uc) 7%,transparent);padding:.7rem 1rem;border-radius:0 10px 10px 0;margin:.8rem 0}
.note{border:1px dashed var(--line);border-radius:10px;padding:.6rem .9rem;color:var(--muted);font-size:.95rem;margin:.8rem 0}
.formula{background:color-mix(in srgb,var(--uc) 5%,var(--card));border:1px solid var(--line);border-radius:12px;padding:.6rem 1rem;margin:.8rem 0;overflow-x:auto}
.lab{border:1px solid var(--line);border-radius:14px;padding:1rem;margin:1rem 0;background:color-mix(in srgb,var(--card) 92%,var(--uc) 8%)}
.lab-title{font-weight:800;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--uc);margin-bottom:.5rem;display:flex;align-items:center;gap:.4rem}
.lab svg{width:100%;height:auto;display:block;user-select:none}
.lab .form-range{accent-color:var(--uc)}
.stat{display:inline-flex;flex-direction:column;padding:.35rem .7rem;border-radius:10px;background:var(--card);border:1px solid var(--line);min-width:5.5rem;margin:.2rem}
.stat b{font-size:1.08rem;font-variant-numeric:tabular-nums}
.stat span{font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
.btn-acc{background:var(--uc,var(--acc));color:#fff;border:none;font-weight:700}
.btn-acc:hover{filter:brightness(1.1);color:#fff}
[data-bs-theme=dark] .btn-acc{color:#111}
.btn-ghost{border:1px solid var(--line);background:var(--card);color:var(--ink);font-weight:600}
.btn-ghost:hover{border-color:var(--uc);color:var(--uc)}
/* problems */
.problem{border:2px solid var(--uc);border-radius:16px;padding:1.1rem 1.2rem;margin:1.2rem 0;background:var(--card);position:relative}
.problem .ptag{position:absolute;top:-.8rem;left:1rem;background:var(--uc);color:#fff;font-weight:800;font-size:.75rem;letter-spacing:.06em;padding:.1rem .6rem;border-radius:6px;text-transform:uppercase}
[data-bs-theme=dark] .problem .ptag{color:#111}
.problem .enun{margin-top:.4rem}
.problem .steps{list-style:none;padding:0;margin:.8rem 0 0;counter-reset:st}
.problem .steps>li{counter-increment:st;position:relative;padding:.6rem .8rem .6rem 3rem;border-radius:10px;margin-bottom:.5rem;background:color-mix(in srgb,var(--uc) 6%,transparent);animation:stepIn .45s ease both}
.problem .steps>li::before{content:counter(st);position:absolute;left:.7rem;top:.6rem;width:1.7rem;height:1.7rem;border-radius:50%;background:var(--uc);color:#fff;font-weight:800;display:grid;place-items:center;font-size:.85rem}
[data-bs-theme=dark] .problem .steps>li::before{color:#111}
.problem .steps>li h6{font-weight:800;margin:0 0 .2rem;font-size:.95rem}
@keyframes stepIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.problem .check-ok{color:var(--ok);font-weight:700}
.problem .check-bad{color:var(--bad);font-weight:700}
.problem table,.topic table.tbl{font-variant-numeric:tabular-nums}
.tbl{width:auto;border-collapse:collapse;margin:.5rem 0;font-size:.92rem}
.tbl th,.tbl td{border:1px solid var(--line);padding:.25rem .55rem;text-align:center}
.tbl th{background:color-mix(in srgb,var(--uc) 14%,var(--card))}
.tbl td.hl{background:color-mix(in srgb,var(--uc) 22%,transparent);font-weight:700}
.scroll-x{overflow-x:auto}
.reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease}
.reveal.in{opacity:1;transform:none}
/* learnings table */
.learn{list-style:none;padding:0;margin:0}
.learn li{display:grid;grid-template-columns:2.2rem 1fr;gap:.5rem;padding:.5rem 0;border-bottom:1px dashed var(--line)}
.learn li .n{font-weight:800;color:var(--uc);text-align:right}
.learn li .tm{display:block;margin-top:.15rem}
.accordion-button:not(.collapsed){background:color-mix(in srgb,var(--uc) 10%,var(--card));color:var(--ink)}
.accordion-item{background:var(--card);border-color:var(--line)}
.accordion-button{background:var(--card);color:var(--ink)}
.modal-content{background:var(--card);color:var(--ink)}
.fgroup h5{font-family:var(--font-head);margin-top:1rem;color:var(--uc)}
.fgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:.6rem}
.fcard{border:1px solid var(--line);border-radius:10px;padding:.5rem .7rem;background:color-mix(in srgb,var(--uc) 4%,var(--card));overflow-x:auto}
.fcard small{display:block;color:var(--muted);font-weight:700;font-size:.75rem;text-transform:uppercase;letter-spacing:.04em}
.fab{position:fixed;right:1.1rem;bottom:1.1rem;z-index:1040;border-radius:99px;padding:.7rem 1.1rem;box-shadow:0 10px 30px -10px rgba(0,0,0,.5)}
#toTop{position:fixed;left:1.1rem;bottom:1.1rem;z-index:1040;opacity:0;pointer-events:none;transition:opacity .3s}
#toTop.show{opacity:1;pointer-events:auto}
svg text{font-family:var(--font-body);fill:var(--ink)}
svg .axis{stroke:var(--muted);stroke-width:1}
svg .gridl{stroke:var(--line);stroke-width:1}
svg .tick{font-size:11px;fill:var(--muted)}
svg .barr{transition:height .5s ease,y .5s ease,fill .3s}
svg .pt{transition:cx .4s,cy .4s}
.quiz-opt.correct{background:var(--ok)!important;color:#fff!important;border-color:var(--ok)!important}
.quiz-opt.wrong{background:var(--bad)!important;color:#fff!important;border-color:var(--bad)!important}
footer{border-top:1px solid var(--line);padding:2rem 0;color:var(--muted);font-size:.92rem}
.katex-display{margin:.4em 0}
@media (max-width:576px){.topic{padding:1rem}.problem{padding:1rem .8rem}.problem .steps>li{padding-left:2.6rem}}
@media print{.navbar,.fab,#toTop,.lab,.problem .btns{display:none!important}.reveal{opacity:1;transform:none}}
.btn-acc:focus,.btn-acc:active,.btn-acc:focus-visible,.btn-acc.active{background:var(--uc,var(--acc))!important;color:#fff!important;border:none}
[data-bs-theme=dark] .btn-acc:focus,[data-bs-theme=dark] .btn-acc:active{color:#111!important}
.btn-ghost.active,.btn-ghost:active,.btn-ghost:focus-visible{background:color-mix(in srgb,var(--uc,var(--acc)) 16%,var(--card))!important;border-color:var(--uc,var(--acc))!important;color:var(--ink)!important}
h1,h2,h3,h4,h5,h6{color:var(--ink)}
.navbar-brand{color:var(--ink)!important}
.navbar-toggler{border-color:var(--line)}
[data-bs-theme=dark] .navbar-toggler-icon{filter:invert(1)}
.katex-display{overflow-x:auto;overflow-y:hidden;padding:.15em 0;max-width:100%}
.problem .steps>li,.def,.note,.topic{min-width:0;overflow-wrap:anywhere}
.lab .stat b{overflow-wrap:anywhere}

pre.code{background:#0f172a;color:#e2e8f0;border-radius:12px;padding:.8rem 1rem;font-size:.86rem;line-height:1.5;overflow-x:auto;margin:.6rem 0;tab-size:4}
pre.code .tk-k{color:#c792ea;font-weight:600} pre.code .tk-s{color:#c3e88d} pre.code .tk-c{color:#7f8ea3;font-style:italic} pre.code .tk-n{color:#f78c6c} pre.code .tk-t{color:#82aaff} pre.code .tk-a{color:#ffcb6b}
.out-console{background:#0b0f14;color:#a7f3d0;font-family:ui-monospace,Consolas,monospace;border-radius:10px;padding:.6rem .9rem;white-space:pre-wrap;font-size:.88rem;min-height:2.4rem}
code{color:var(--uc,var(--acc));background:color-mix(in srgb,var(--uc,var(--acc)) 10%,transparent);padding:.05rem .3rem;border-radius:4px}
pre code{background:none;padding:0;color:inherit}
.bit{width:2.6rem;height:2.6rem;border-radius:10px;border:2px solid var(--line);background:var(--card);font-weight:800;font-size:1.2rem;font-family:ui-monospace,monospace;transition:all .25s;color:var(--ink)}
.bit.on{background:var(--uc);border-color:var(--uc);color:#fff;transform:translateY(-3px);box-shadow:0 6px 14px -6px var(--uc)}
.bitw{font-size:.7rem;color:var(--muted);text-align:center}
.flip{perspective:900px;cursor:pointer;min-height:220px}
.flip .inner{position:relative;width:100%;height:100%;min-height:220px;transition:transform .7s;transform-style:preserve-3d}
.flip.on .inner{transform:rotateY(180deg)}
.flip .face{position:absolute;inset:0;backface-visibility:hidden;border:1px solid var(--line);border-radius:14px;padding:1rem;background:var(--card);overflow:auto}
.flip .back{transform:rotateY(180deg);background:color-mix(in srgb,var(--uc) 8%,var(--card))}
.flip .yr{font-family:var(--font-head);font-size:2rem;color:var(--uc);font-weight:700}
.mock{border:1px solid #9aa4b2;border-radius:8px;overflow:hidden;background:#eef1f5;color:#111;max-width:520px;font-family:system-ui,sans-serif;font-size:.9rem;box-shadow:0 12px 30px -16px rgba(0,0,0,.5)}
.mock .tb{background:linear-gradient(#e4e8ee,#cfd6df);padding:.3rem .6rem;font-weight:600;display:flex;justify-content:space-between}
.mock .mb{background:#f7f8fa;border-bottom:1px solid #c5ccd6;padding:.2rem .4rem;display:flex;gap:.8rem;position:relative}
.mock .mb span{cursor:pointer;padding:0 .3rem} .mock .mb span:hover{background:#dbe4f0}
.mock .menu{position:absolute;top:100%;left:.4rem;background:#fff;border:1px solid #b9c2cf;box-shadow:0 6px 16px -6px rgba(0,0,0,.4);z-index:5;min-width:9rem;display:none}
.mock .menu div{padding:.25rem .7rem;cursor:pointer} .mock .menu div:hover{background:#2f6fd6;color:#fff}
.mock input[type=text],.mock textarea{border:1px solid #9aa4b2;background:#fff;color:#111;border-radius:2px;padding:.15rem .3rem;width:100%}
.mock button{border:1px solid #8b95a3;background:linear-gradient(#fdfdfd,#dfe4ea);border-radius:4px;padding:.15rem .8rem;color:#111}
.evlog{font-family:ui-monospace,monospace;font-size:.8rem;max-height:9rem;overflow:auto}
.evlog div{animation:stepIn .35s ease both}
.cell{display:inline-flex;flex-direction:column;align-items:center;margin:2px}
.cell b{width:3rem;height:3rem;display:grid;place-items:center;border:2px solid var(--uc);border-radius:8px;font-family:ui-monospace,monospace;background:var(--card);transition:all .3s}
.cell b.hot{background:var(--uc);color:#fff;transform:translateY(-4px)}
.cell b.new{animation:pop .45s ease} .cell small{color:var(--muted);font-size:.7rem}
@keyframes pop{from{transform:scale(.3);opacity:0}to{transform:none;opacity:1}}
.kmap td{width:3rem;height:3rem;cursor:pointer;font-family:ui-monospace,monospace;font-weight:800;font-size:1.05rem;position:relative}
.kmap td.one{background:color-mix(in srgb,var(--uc) 22%,transparent)}
.stage{transition:all .35s;padding:.4rem .7rem;font-size:.85rem}
.stage.on{background:var(--uc,var(--acc));color:#fff;border-color:var(--uc,var(--acc));transform:translateY(-3px)}

:root{--u4:#be185d;--u5:#2563eb}
[data-bs-theme=dark]{--u4:#f472b6;--u5:#60a5fa}
.u4{--uc:var(--u4)} .u5{--uc:var(--u5)}
#progress{background:linear-gradient(90deg,var(--u1),var(--u2),var(--u3),var(--u4),var(--u5))}
.ax0{stroke:var(--ink);stroke-width:1.6;opacity:.75}
.axarr{fill:var(--ink);opacity:.75}
.tick.fw{font-weight:800;font-style:italic;font-size:13px}
.plbl{font-size:13px;font-weight:700;paint-order:stroke;stroke:var(--card);stroke-width:4px;stroke-linejoin:round}
.dragpt{cursor:grab;outline:none}
.dragpt circle{transition:r .15s}
.dragpt:hover circle,.dragpt:focus circle,.dragpt.on circle{r:12}
.dragpt.on{cursor:grabbing}
.readout{font-family:var(--font-body);background:var(--card);border:1px solid var(--line);border-radius:10px;padding:.6rem .8rem;font-size:.95rem}
.readout .katex{font-size:1.05em}
.readout b{color:var(--uc)}
.kbd-hint{font-size:.78rem;color:var(--muted)}
.formula{background:color-mix(in srgb,var(--uc) 6%,var(--card));border:1px solid color-mix(in srgb,var(--uc) 30%,var(--line));border-radius:12px;padding:.4rem .8rem;margin:.8rem 0;overflow-x:auto}
.thm{border:1px solid color-mix(in srgb,var(--uc) 40%,var(--line));border-radius:12px;padding:.7rem 1rem;margin:.8rem 0;background:var(--card)}
.thm>b:first-child{color:var(--uc);text-transform:uppercase;font-size:.78rem;letter-spacing:.06em;display:block;margin-bottom:.15rem}
.tbl td,.tbl th{vertical-align:middle}
.tbl.diff td.hl{background:color-mix(in srgb,var(--uc) 18%,transparent);font-weight:700}
.numline{width:100%;height:auto}
.nest text{font-weight:800}
.chip-btn{cursor:pointer}
.chip-btn.on{background:var(--uc);color:#fff;border-color:var(--uc)}
.balance-wrap svg{max-width:560px;margin:auto}
.step-anim li{opacity:.35;transition:opacity .3s}
.step-anim li.on{opacity:1;font-weight:600}
.construct-step{min-height:3.2rem}
.gstroke{fill:none;stroke:var(--uc);stroke-width:2.5}
.compass{fill:none;stroke:var(--muted);stroke-width:1.6;stroke-dasharray:5 4}
.ang-arc{fill:color-mix(in srgb,var(--uc) 22%,transparent);stroke:var(--uc);stroke-width:1.6}
.hl-pair{stroke-width:4!important}
.pie-slice{transition:opacity .2s}
.lab .btn-group .btn.active{background:var(--uc);color:#fff;border-color:var(--uc)}
.sym{font-family:var(--font-head);font-size:1.6rem;font-weight:700;color:var(--uc)}
.mini-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.6rem}
.mini-grid .cell{border:1px solid var(--line);border-radius:10px;padding:.5rem .7rem;background:var(--card);text-align:center}
.mini-grid .cell .sym{display:block}
.synth td{min-width:3rem;text-align:center;font-family:ui-monospace,monospace}
.synth td.r{border-top:2px solid var(--ink)}
.synth td.res{background:color-mix(in srgb,var(--uc) 18%,transparent);font-weight:800}
.synth td.new{animation:pop .5s}
@keyframes pop{0%{transform:scale(1.5);color:var(--uc)}100%{transform:none}}
@media (max-width:576px){.plbl{font-size:12px}}

.problem .enun{overflow-x:auto;overflow-y:hidden}
.readout{overflow-x:auto}

.cd-table{width:100%;border-collapse:collapse;font-size:.9rem;background:var(--card)}
.cd-table th{background:#878787;color:#fff;text-align:center;padding:.4rem .6rem;font-weight:700;border:1px solid #6f6f6f}
.cd-table td{vertical-align:top;padding:.55rem .7rem;border:1px solid var(--line);background:color-mix(in srgb,var(--card) 88%,#888 12%)}
.cd-table tbody tr:nth-child(even) td{background:color-mix(in srgb,var(--card) 80%,#888 20%)}
.cd-table td p{line-height:1.45}
.cd-table img{background:#fff;border-radius:4px}
.cd-table td.cd-sec{background:color-mix(in srgb,var(--card) 70%,#888 30%);text-align:center;font-weight:700}
.cd-pg{font-size:.7rem;color:var(--muted);text-align:right;margin-top:.3rem}
.cd-prop td{font-size:.95rem}
#cartaModal .modal-body{background:var(--paper)}
@media (max-width:768px){.cd-table{font-size:.82rem;min-width:720px}}
@media print{#cartaModal{position:static!important;display:block!important}.modal-backdrop{display:none}}
@media (max-width:768px){.cd-table.cd-prop{min-width:0}}
.fab2{position:fixed;right:1.1rem;bottom:4.6rem;z-index:1040;border-radius:99px;padding:.6rem 1rem;box-shadow:0 10px 30px -10px rgba(0,0,0,.5)}

.cswitch{display:flex;gap:.25rem;background:color-mix(in srgb,var(--card) 70%,var(--line));border:1px solid var(--line);border-radius:99px;padding:.2rem}
.cswitch button{border:0;background:none;border-radius:99px;padding:.3rem .8rem;font-weight:800;font-size:.85rem;color:var(--muted);transition:background .2s,color .2s;white-space:nowrap}
.cswitch button:hover{color:var(--ink)}
.cswitch button.on{background:var(--cc);color:#fff}
.navbar .nav-link{white-space:nowrap}
@media (max-width:400px){.cswitch button{padding:.3rem .55rem}}
#home .hero{padding-bottom:1.5rem}
.ccard{display:block;height:100%;border:1px solid var(--line);border-radius:18px;padding:1.2rem 1.25rem;background:var(--card);color:var(--ink);text-decoration:none;position:relative;overflow:hidden;transition:transform .25s,box-shadow .25s,border-color .25s}
.ccard::before{content:'';position:absolute;inset:0 0 auto 0;height:6px;background:var(--cc)}
.ccard:hover,.ccard:focus-visible{transform:translateY(-4px);box-shadow:0 18px 40px -22px rgba(0,0,0,.45);border-color:var(--cc);color:var(--ink)}
.ccard .roman{font-family:var(--font-head);font-size:3rem;line-height:1;color:var(--cc);font-weight:700}
.ccard ol{padding-left:1.1rem;margin:.6rem 0 .8rem;font-size:.92rem}
.ccard ol li{margin:.15rem 0}
.ccard ol li span{color:var(--muted);font-size:.8rem;margin-left:.3rem}
.ccard .go{font-weight:800;color:var(--cc)}
