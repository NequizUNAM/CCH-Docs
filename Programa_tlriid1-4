function qrMatrix(text){
  var bytes=new TextEncoder().encode(text),s='';
  for(var i=0;i<bytes.length;i++)s+=String.fromCharCode(bytes[i]);
  for(var v=1;v<=40;v++){try{var q=new QRB.QRCode(v,QRB.ECL.M);q.addData(s);q.make();return q;}catch(e){}}
  throw new Error('Texto demasiado largo para QR');
}
function drawQR(cv,text){
  var q=qrMatrix(text),n=q.getModuleCount(),qz=4,tot=n+2*qz,px=Math.floor(cv.width/tot)||1,size=px*tot;
  var ctx=cv.getContext('2d');cv.width=cv.height=size;ctx.fillStyle='#fff';ctx.fillRect(0,0,size,size);ctx.fillStyle='#000';
  for(var r=0;r<n;r++)for(var c=0;c<n;c++)if(q.isDark(r,c))ctx.fillRect((c+qz)*px,(r+qz)*px,px,px);
  return q;
}
var LSK='cch-programas-url-base';
function lsGet(k){try{return localStorage.getItem(k)||'';}catch(e){return '';}}
